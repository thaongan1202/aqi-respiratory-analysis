                <story-points>
                  <story-point caption='Asthma tập trung ở mức cao hơn (khoảng 9–12%), COPD trải rộng hơn (khoảng 4–9%). Hút thuốc cho thấy mối liên hệ rõ và nhất quán với cả hai bệnh' captured-sheet='Dashboard2_PhanTich' id='1' />
                </story-points>

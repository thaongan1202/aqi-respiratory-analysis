      <column caption='Unhealthy %' datatype='real' name='[Calculation_9166956566278153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Unhealthy_Days]) / SUM([Days_with_AQI])' />
      </column>
      <column caption='Very Unhealthy %' datatype='real' name='[Calculation_9166956566360074]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Very_Unhealthy_Days]) / SUM([Days_with_AQI])' />
      </column>
      <column caption='Hazardous %' datatype='real' name='[Calculation_9166956566441995]' role='measure' type='quantitative'>

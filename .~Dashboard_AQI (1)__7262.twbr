      <column caption='Nhóm mức AQI' datatype='string' name='[Calculation_0015030111473682]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Median_AQI] &lt;= 50 THEN &quot;Good&quot;&#10;ELSEIF [Median_AQI] &lt;= 100 THEN &quot;Moderate&quot;&#10;ELSEIF [Median_AQI] &lt;= 150 THEN &quot;USG&quot;&#10;ELSEIF [Median_AQI] &lt;= 200 THEN &quot;Unhealthy&quot;&#10;ELSEIF [Median_AQI] &lt;= 300 THEN &quot;Very Unhealthy&quot;&#10;ELSE &quot;Hazardous&quot;&#10;END' />
      </column>
      <column caption='State_Top5' datatype='string' name='[Calculation_1360696204902405]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[State]' />
      </column>
      <column caption='Region' datatype='string' name='[Calculation_1599292288770048]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [State]&#13;&#10;WHEN &quot;Connecticut&quot; THEN &quot;Northeast&quot;&#13;&#10;WHEN &quot;Maine&quot; THEN &quot;Northeast&quot;&#13;&#10;WHEN &quot;Massachusetts&quot; THEN &quot;Northeast&quot;&#13;&#10;WHEN &quot;New Hampshire&quot; THEN &quot;Northeast&quot;&#13;&#10;WHEN &quot;Rhode Island&quot; THEN &quot;Northeast&quot;&#13;&#10;WHEN &quot;Vermont&quot; THEN &quot;Northeast&quot;&#13;&#10;WHEN &quot;New Jersey&quot; THEN &quot;Northeast&quot;&#13;&#10;WHEN &quot;New York&quot; THEN &quot;Northeast&quot;&#13;&#10;WHEN &quot;Pennsylvania&quot; THEN &quot;Northeast&quot;&#13;&#10;WHEN &quot;Illinois&quot; THEN &quot;Midwest&quot;&#13;&#10;WHEN &quot;Indiana&quot; THEN &quot;Midwest&quot;&#13;&#10;WHEN &quot;Michigan&quot; THEN &quot;Midwest&quot;&#13;&#10;WHEN &quot;Ohio&quot; THEN &quot;Midwest&quot;&#13;&#10;WHEN &quot;Wisconsin&quot; THEN &quot;Midwest&quot;&#13;&#10;WHEN &quot;Iowa&quot; THEN &quot;Midwest&quot;&#13;&#10;WHEN &quot;Kansas&quot; THEN &quot;Midwest&quot;&#13;&#10;WHEN &quot;Minnesota&quot; THEN &quot;Midwest&quot;&#13;&#10;WHEN &quot;Missouri&quot; THEN &quot;Midwest&quot;&#13;&#10;WHEN &quot;Nebraska&quot; THEN &quot;Midwest&quot;&#13;&#10;WHEN &quot;North Dakota&quot; THEN &quot;Midwest&quot;&#13;&#10;WHEN &quot;South Dakota&quot; THEN &quot;Midwest&quot;&#13;&#10;WHEN &quot;Delaware&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;Florida&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;Georgia&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;Maryland&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;North Carolina&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;South Carolina&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;Virginia&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;District of Columbia&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;West Virginia&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;Alabama&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;Kentucky&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;Mississippi&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;Tennessee&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;Arkansas&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;Louisiana&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;Oklahoma&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;Texas&quot; THEN &quot;South&quot;&#13;&#10;WHEN &quot;Arizona&quot; THEN &quot;West&quot;&#13;&#10;WHEN &quot;Colorado&quot; THEN &quot;West&quot;&#13;&#10;WHEN &quot;Idaho&quot; THEN &quot;West&quot;&#13;&#10;WHEN &quot;Montana&quot; THEN &quot;West&quot;&#13;&#10;WHEN &quot;Nevada&quot; THEN &quot;West&quot;&#13;&#10;WHEN &quot;New Mexico&quot; THEN &quot;West&quot;&#13;&#10;WHEN &quot;Utah&quot; THEN &quot;West&quot;&#13;&#10;WHEN &quot;Wyoming&quot; THEN &quot;West&quot;&#13;&#10;WHEN &quot;Alaska&quot; THEN &quot;West&quot;&#13;&#10;WHEN &quot;California&quot; THEN &quot;West&quot;&#13;&#10;WHEN &quot;Hawaii&quot; THEN &quot;West&quot;&#13;&#10;WHEN &quot;Oregon&quot; THEN &quot;West&quot;&#13;&#10;WHEN &quot;Washington&quot; THEN &quot;West&quot;&#13;&#10;ELSE &quot;Unknown&quot;&#13;&#10;END' />
      </column>
      <column caption='Dân số' datatype='integer' name='[Calculation_1603140864802816]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [CountyFIPS],[Year] : MAX([Population]) }' />
      </column>
      <column caption='Khoang_Nam' datatype='string' name='[Calculation_1603140866777089]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([Year]) = MAX([Year]) THEN STR(MIN([Year]))&#13;&#10;   ELSE STR(MIN([Year])) + &quot;–&quot; + STR(MAX([Year]))&#13;&#10;   END' />
      </column>
      <column caption='Dân số trung bình' datatype='real' name='[Calculation_1603140933111810]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1603140864802816]) / COUNTD([Year]))' />
      </column>
      <column caption='Cơ cấu số ngày AQI' datatype='string' name='[Calculation_1603140944953347]' role='measure' type='nominal'>
        <calculation class='tableau' formula='&quot; + ATTR([County]) &quot; + &quot;, &quot; + ATTR([StateAbbr]) + &quot; (&quot; + STR(ATTR([Year])) + &quot;)&quot;' />
      </column>
      <column caption='Good' datatype='real' name='[Calculation_1603140952227844]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Good_Days]) / (SUM([Good_Days]) + SUM([Moderate_Days]) + SUM([USG_Days]) + SUM([Unhealthy_Days]) + SUM([Very_Unhealthy_Days]) + SUM([Hazardous_Days]))' />
      </column>
      <column caption='Moderate' datatype='integer' name='[Calculation_1603140952354821]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Moderate_Days])' />
      </column>
      <column caption='USG' datatype='integer' name='[Calculation_1603140952498182]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([USG_Days])' />
      </column>
      <column caption='Unhealthy' datatype='integer' name='[Calculation_1603140952666119]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Unhealthy_Days])' />
      </column>
      <column caption='Very Unhealthy' datatype='integer' name='[Calculation_1603140952752136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Very_Unhealthy_Days])' />
      </column>
      <column caption='Hazardous' datatype='integer' name='[Calculation_1603140952858633]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Hazardous_Days])' />
      </column>
      <column caption='Label_End' datatype='string' name='[Calculation_1625130931544064]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF LAST() = 0 THEN&#13;&#10;ATTR([State]) + &quot;: &quot; + STR(ROUND(AVG([Median_AQI]),1))&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Good %' datatype='real' name='[Calculation_9166956565860358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Good_Days]) / SUM([Days_with_AQI])' />
      </column>
      <column caption='Moderate %' datatype='real' name='[Calculation_9166956566024199]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Moderate_Days]) / SUM([Days_with_AQI])' />

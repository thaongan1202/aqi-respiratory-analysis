            <zone fixed-size='249' h='98118' id='98' is-fixed='true' param='vert' type-v2='layout-flow' w='17786' x='81643' y='941'>
              <zone h='8823' id='100' mode='slider' param='[Parameters].[Parameter 1296103159148544]' type-v2='paramctrl' w='17786' x='81643' y='941'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='2' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone h='8235' id='85' name='DuBao' pane-specification-id='0' param='[federated.12oiz7l0pvjc6e1eu0qih10p96uu].[none:Disease:nk]' type-v2='color' w='17786' x='81643' y='9764'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
                  <format attr='border-style' value='solid' />
                  <format attr='border-width' value='2' />
                  <format attr='margin' value='4' />
                </zone-style>
              </zone>
              <zone forceUpdate='true' h='50353' id='107' type-v2='text' w='17786' x='81643' y='17999'>
                <formatted-text>
                  <run bold='true' fontalignment='1' fontcolor='#0a3c6a' fontname='Tableau Bold' fontsize='11'> MÔ HÌNH WLS</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#0a3c6a' fontname='Tableau Bold' fontsize='11'>Biến phụ thuộc:</run>
                  <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'> Disease_AdjPrev - tỷ lệ mắc bệnh chuẩn hóa tuổi (%)</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#0a3c6a' fontname='Tableau Bold' fontsize='11'>Biến độc lập:</run>
                  <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'> Median_AQI, Smoking_AdjPrev</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#0a3c6a' fontname='Tableau Bold' fontsize='11'>Trọng số: </run>
                  <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>ghi đúng biến/công thức weights trong code của C</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#0a3c6a' fontname='Tableau Bold' fontsize='11'>Số quan sát:</run>
                  <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'> COPD: model_copd.nobs | Hen suyễn: model_asthma.nobs </run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#0a3c6a' fontname='Tableau Bold' fontsize='11'>R² của mô hình:</run>
                  <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'> COPD = </run>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>0,838</run>
                  <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'> | Hen suyễn = </run>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>0,390</run>
                  <run>Æ&#10;</run>
                  <run bold='true' fontcolor='#0a3c6a' fontname='Tableau Bold' fontsize='11'>Hệ số AQI:</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>• COPD: β = </run>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>+0,0078</run>
                  <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>, </run>
                  <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11' italic='true'>p</run>
                  <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'> &lt; </run>
                  <run bold='true' fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>0,001</run>
                  <run>Æ&#10;</run>
                  <run fontcolor='#000000' fontname='Tableau Bold' fontsize='11'>• Hen suyễn: β = </run>
